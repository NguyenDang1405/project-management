# Node modules
node_modules/
.gitignore
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/Jest
coverage/

# nyc test coverage
.nyc_output/

# dotenv environment files
.env
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# build output
dist/
build/
tmp/
temp/

# Typescript cache
*.tsbuildinfo

# Optional npm cache directory
.npm/

# VSCode settings
.vscode/

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Debugging
.idea/
*.sublime-workspace
*.sublime-project

# Ignore next.js output (if applicable)
.next/
out/

# Ignore eslint cache
.eslintcache

# Ignore parcel-bundler cache
.cache/

# Ignore bun build output
.bun/

# Ignore Remix and similar frameworks
.server/

# Optional lock files (keep one of these if needed)
package-lock.json
# yarn.lock
# pnpm-lock.yaml
