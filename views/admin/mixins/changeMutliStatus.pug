mixin formChangeMultiStatus(action)
     form(
        action=action
        method="POST"
        form-change-multi  
    )
        .d-flex.align-items-start
            .form-group
                select(name="type" class="form-control")
                    option(disabled selected) --chọn hành động--
                    option(value="active") Hoạt động 
                    option(value="inactive") Ngừng hoạt động
                    option(value="deleteAll") Xóa tất cả
                    option(value="changePosition") Thay đổi vị trí
            .form-group.ml-1
                input(
                    type="text"
                    name="ids"
                    value=""
                    class="form-control d-none"
                )
            button.btn.btn-success.ml-1(type="submit") Áp dụng
mixin form-change-multi-order(path)
    form(action=path , method='POST', class='form-change-multi') 
        .d-flex.align-items-start
            .form-group
                select(name="type" class="form-control")
                    option(disabled) --Chọn hành động--
                    option(value="initit") Khởi tạo đơn hàng
                    option(value="confirm") Xác nhận đơn hàng
                    option(value="delete-all") Hủy tất cả
            .form-group
                input(type="text" name="ids" value="" class="form-control d-none")
            button(type='submit' class="btn btn-primary") Áp dụng
