mixin table-tree(records, level = 1 )
    each item, index in records
        - const prefix = Array(level + 1).join(("-- "))
        tr
            td.text-center
                input(type="checkbox" name="id" value=item.id)
            td.text-center.font-weight-bold #{index + 1}
            td.text-center
                img.img-thumbnail(src=item.thumbnail alt=item.title style="width: 60px; height: 60px; object-fit: cover;")
            td.text-center
                .product-info
                    .product-name.font-weight-bold #{prefix} #{item.title}
            td.text-center
                .position 
                    input(type="number" value=item.position style="width:60px" min="1" name="position")
            td.text-center
                if item.status === "active"
                    a(href="javascript:;" data-status=item.status data-id=item.id button-change-status).badge.badge-success Đang hoạt động
                else
                    a(href="javascript:;" data-status=item.status data-id=item.id button-change-status).badge.badge-danger Ngừng hoạt động
            td.text-center
                .btn-group(role="group")
                    a.btn.btn-sm.btn-outline-primary(href=`${prefixAdmin}/products/detail/${item.id}` title="Xem chi tiết")
                        i.fas.fa-eye
                    a.btn.btn-sm.btn-outline-warning(href=`${prefixAdmin}/products/edit/${item.id}` title="Chỉnh sửa")
                        i.fas.fa-edit
                    a.btn.btn-sm.btn-outline-danger(href="javascript:;" title="Xóa" button-delete data-id=item.id)
                        i.fas.fa-trash
            if( item.children &&  item.children.length > 0)
                +table-tree(item.children, level + 1)