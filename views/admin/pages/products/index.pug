extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/changeMutliStatus.pug
include ../../mixins/alert.pug
block main 
    +alert-success(5000)
    .container-fluid
        .row
            .col-12
                .card
                    .card-header.d-flex.justify-content-between.align-items-center
                        h4.mb-0 
                            i.fas.fa-box.mr-2
                            | Quản lý sản phẩm
                        .header-actions
                            a.btn.btn-success.btn-sm.mr-2(href=`${prefixAdmin}/products/create`)
                                i.fas.fa-plus.mr-1
                                | Thêm sản phẩm

                    .card-body
                        // Search and Filter Section
                        .row.mb-3.d-flex.justify-content-between.align-items-center 
                            .col-md-6.flex-fill
                                +search(keyword)
                            .col-md-6.flex-shrink-0.text-right
                                .btn-group(role="group")
                                    +filter_status(filterStatus)
                        +formChangeMultiStatus(`${prefixAdmin}/products/change-multi?_method=PATCH`)
        // Products Table
        .table-responsive
            table(class="table table-hover table-bordered" checkbox-multi)
                thead.thead-dark
                    tr
                        th.text-center(width="4%") 
                            input(type="checkbox" name="checkall" )
                        th.text-center(width="6%") STT
                        th.text-center(width="10%") Hình ảnh
                        th.text-center(width="30%") Tiêu đề
                        th.text-center(width="12%") Giá
                        th.text-center(width="8%") Vị trí
                        th.text-center(width="15%") Trạng thái
                        th.text-center(width="15%") Hành động
                tbody
                if products  &&  products.length > 0
                    each item, index in products
                        tr
                            td.text-center
                                input(type="checkbox" name="id" value=item.id)
                            td.text-center.font-weight-bold #{index + 1}
                            td.text-center
                                img.img-thumbnail(src=item.thumbnail alt=item.title style="width: 60px; height: 60px; object-fit: cover;")
                            td.text-center
                                .product-info
                                    .product-name.font-weight-bold #{item.title}
                            td.text-center
                                .price-info
                                    .price-old.text-muted.small
                                        s #{item.price}$
                                    .price-new.font-weight-bold.text-success #{item.newPrice}$
                            td.text-center
                                .position 
                                    input(type="number" value=item.position style="width:60px" min="1" name="position")
                            td.text-center
                                if item.status === "active"
                                    a(href="javascript:;" data-status=item.status data-id=item.id button-change-status).badge.badge-success Đang hoạt động
                                else
                                    a(href="javascript:;" data-status=item.status data-id=item.id button-change-status).badge.badge-danger Ngừng hoạt động
                            td.text-center
                                .btn-group(role="group")
                                    button.btn.btn-sm.btn-outline-primary(title="Xem chi tiết")
                                        i.fas.fa-eye
                                    button.btn.btn-sm.btn-outline-warning(title="Chỉnh sửa")
                                        i.fas.fa-edit
                                    button.btn.btn-sm.btn-outline-danger(title="Xóa" button-delete data-id=item.id)
                                        i.fas.fa-trash
        // Pagination Section
        .row.mt-3
            .col-12
                +pagination(pagination)
        form(
            action=""
            method="POST"
            id="form-change-status"
            data-path=`${prefixAdmin}/products/change-status`
        )
        form(
            action=""
            method="POST"
            id="form-delete-item"
            data-path=`${prefixAdmin}/products/delete`
        )