extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
block main 
    .container-fluid
        .row
            .col-12
                .card
                    .card-header.d-flex.justify-content-between.align-items-center
                        h4.mb-0 
                            i.fas.fa-box.mr-2
                            | Quản lý sản phẩm
                        .header-actions
                            button.btn.btn-success.btn-sm.mr-2(data-toggle="modal" data-target="#addProductModal")
                                i.fas.fa-plus.mr-1
                                | Thêm sản phẩm
                    
                    .card-body
                        // Search and Filter Section
                        .row.mb-3.d-flex.justify-content-between.align-items-center 
                            .col-md-6.flex-fill
                                +search(keyword)
                            .col-md-6.flex-shrink-0.text-right
                               .btn-group(role="group")
                                    +filter_status(filterStatus)

                        // Products Table
                        .table-responsive
                            table.table.table-hover.table-bordered
                                thead.thead-dark
                                    tr
                                        th.text-center(width="8%") STT
                                        th.text-center(width="15%") Hình ảnh
                                        th.text-center(width="35%") Tiêu đề
                                        th.text-center(width="15%") Giá
                                        th.text-center(width="12%") Trạng thái
                                        th.text-center(width="15%") Hành động
                                tbody
                                if products  &&  products.length > 0
                                    each item, index in products
                                        tr
                                            td.text-center.font-weight-bold #{index + 1}
                                            td.text-center
                                                img.img-thumbnail(src=item.thumbnail alt=item.title style="width: 60px; height: 60px; object-fit: cover;")
                                            td.text-center
                                                .product-info
                                                    .product-name.font-weight-bold #{item.title}
                                            td.text-center
                                                .price-info
                                                    .price-old.text-muted.small
                                                        s #{item.price}$
                                                    .price-new.font-weight-bold.text-success #{item.newPrice}$
                                            td.text-center
                                                if item.status === "active"
                                                    span.badge.badge-success Đang hoạt động
                                                else
                                                    span.badge.badge-danger Ngừng hoạt động
                                            td.text-center
                                                .btn-group(role="group")
                                                    button.btn.btn-sm.btn-outline-primary(title="Xem chi tiết")
                                                        i.fas.fa-eye
                                                    button.btn.btn-sm.btn-outline-warning(title="Chỉnh sửa")
                                                        i.fas.fa-edit
                                                    button.btn.btn-sm.btn-outline-danger(title="Xóa")
                                                        i.fas.fa-trash

                        //- // Actions and Pagination
                        //- .row.mt-3
                        //-     .col-md-6
                        //-         .action-buttons
                        //-             button.btn.btn-sm.btn-outline-success
                        //-                 i.fas.fa-file-excel.mr-1
                        //-                 | Xuất Excel
                        //-             button.btn.btn-sm.btn-outline-info.ml-2
                        //-                 i.fas.fa-sync.mr-1
                        //-                 | Làm mới

                        // Pagination Section
                        .row.mt-3
                            .col-12
                                nav(aria-label="Page navigation")
                                    ul.pagination.justify-content-end.mb-0
                                        // Previous Button
                                        if pagination.currentPage > 1
                                            li.page-item
                                                button.page-link(button-pagination=(pagination.currentPage - 1)) Trước
                                        // Page Numbers
                                        - for (let i = 1; i <= pagination.totalPage; i++)
                                            li(class=`page-item ${pagination.currentPage == i ? "active" : ""}`)
                                                button.page-link(button-pagination=i) #{i}
                                        
                                        // Next Button
                                        if pagination.currentPage < pagination.totalPage
                                            li.page-item
                                                button.page-link(button-pagination=pagination.currentPage + 1) Sau
                        //- // Stats Footer
                        //- .row.mt-3.pt-3.border-top
                        //-     .col-md-6
                        //-         small.text-muted Hiển thị 1-10 trong tổng số 245 sản phẩm
                        //-     .col-md-6.text-right
                        //-         small.text-muted 
                        //-             | Tổng giá trị kho: 
                        //-             span.font-weight-bold.text-success 2,450,000,000₫