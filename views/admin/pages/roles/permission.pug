extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    h1 Phân quyền
    +alert-success(5000)

    if (records.length > 0)
        div(data-records=records)
        div.text-right
            button.btn.btn-primary.mb-3(
                type="submit"
                button-submit
            ) Cập nhật

        table.table.table-hover.table-sm(table-permissions)
            thead
                tr
                    th Tính năng
                    each record in records
                        th.text-center #{record.title}
            tbody
                //- hidden id row
                tr.d-none(data-name="id")
                    td
                    each record in records 
                        td.text-center
                            input(type="text" value=record.id)

                //- Danh mục sản phẩm
                tr
                    td(colspan="5")
                        b Danh mục sản phẩm
                tr(data-name="products_category_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_category_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_category_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_category_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")

                //- Sản phẩm
                tr
                    td(colspan="4")
                        b Sản phẩm
                tr(data-name="products_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")

                //- Đơn hàng
                tr
                    td(colspan="4")
                        b Đơn hàng
                tr(data-name="orders_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="orders_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="orders_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="orders_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")

                //- Nhóm quyền
                tr
                    td(colspan="4")
                        b Nhóm quyền
                tr(data-name="roles_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_permissions")
                    td Phân quyền
                    each record in records
                        td.text-center
                            input(type="checkbox")

                //- Tài khoản admin
                tr
                    td(colspan="4")
                        b Tài khoản admin
                tr(data-name="accounts_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="accounts_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="accounts_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="accounts_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")

                //- Tài khoản client
                tr
                    td(colspan="4")
                        b Tài khoản client
                tr(data-name="users_view")
                    td Xem
                    each record in records 
                        td.text-center
                            input(type="checkbox")
                tr(data-name="users_create")
                    td Thêm mới
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="users_edit")
                    td Chỉnh sửa
                    each record in records
                        td.text-center
                            input(type="checkbox")
                tr(data-name="users_delete")
                    td Xóa
                    each record in records
                        td.text-center
                            input(type="checkbox")

    form#form-change-permissions.d-none(
        method="POST"
        action=`${prefixAdmin}/roles/permission?_method=PATCH`
    )
        .form-group
            input.form-control(
                type="text"
                name="permissions"
            )
        script(src="/admin/js/role.js")
